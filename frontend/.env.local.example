NEXT_PUBLIC_API_URL=https://api.credencesports.com
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
# Cognito Hosted-UI domain host (no scheme). Enables "Continue with Google" (E9.7).
# Leave blank to hide the Google button (password login still works).
#
# ⚠️ THIS IS THE REAL VALUE — it is not a guessable brand name. The pool has NO custom
# domain; the prefix is the USER POOL ID lowercased with the underscore removed
# (us-east-1_gG9zMbwQt → us-east-1gg9zmbwqt). This line, `infrastructure/aws_resources.md`
# and the comment in `frontend/lib/cognito.ts` each used to carry a DIFFERENT made-up
# host, none of which resolved — which is how a wrong value reached Vercel and took the
# only signup path in production down with a browser DNS error (2026-08-06).
# Re-derive truth with:
#   aws cognito-idp describe-user-pool --user-pool-id us-east-1_gG9zMbwQt \
#     --query 'UserPool.{Domain:Domain,CustomDomain:CustomDomain}'
NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=us-east-1gg9zmbwqt.auth.us-east-1.amazoncognito.com
# Comma-separated admin emails (controls /admin page access and admin API calls)
NEXT_PUBLIC_ADMIN_EMAILS=
