# E9.63 — the build-time environment the E2E smoke suite compiles against.
#
# Sourced by `npm run e2e:build`. Every value here is FAKE ON PURPOSE. `NEXT_PUBLIC_*` values are
# inlined at BUILD time, so this file is what the browser sees — and none of it may be able to
# reach a real service.

# A SAME-ORIGIN prefix, and the reason is a real constraint rather than a preference.
#
# The first cut pointed this at `http://api.e2e.invalid` (the reserved never-resolvable TLD) so an
# un-intercepted call could not possibly reach production. It does not work, and it fails in the
# most misleading way available: `next.config.mjs` ships a CSP whose `connect-src` allowlists only
# `'self'` and the real API host, so the browser REFUSES the fetch before it ever becomes a network
# request — Playwright's route handler never fires, `apiFetch` rejects, and every fantasy surface
# renders its "not published yet" EMPTY STATE. Which is to say the suite would have been asserting
# against a blank page while reporting that it had mocked the API. (That is the same silent-empty
# shape as the E9.56b bug this suite exists to catch, arriving through the test harness instead.)
#
# `/__e2e-api` is same-origin, so CSP permits it; it collides with no Next route; and it still
# cannot reach production — the only server it can resolve to is the local `next start`. An
# un-intercepted call lands on a Next 404 and surfaces as a visible failure.
NEXT_PUBLIC_API_URL=/__e2e-api

# Cognito. A well-FORMED but non-existent pool/client/Hosted-UI host. The Hosted-UI domain must be
# non-empty or `isHostedUiConfigured()` is false and every "Continue with Google" affordance
# swaps itself out for the mailto fallback — i.e. the suite would be asserting the absence of the
# thing E9.58 shipped. The host prefix mirrors prod's real derivation (pool id lowercased, the
# underscore removed) so the shape under test matches the shape that ships.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_e2eTestPool
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=e2etestappclientid000000
NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=us-east-1e2etestpool.auth.us-east-1.amazoncognito.com

# G100-C1 — a NON-EMPTY token so `posthog.init` actually arms and `capture()` reaches the wire.
# It was empty, which meant analytics were silently inert in the E2E build and the activation
# event (G100-D0's `custom_board_viewed`) could not be tested at all — only asserted about.
# The value is fake and the ingest host is same-origin (`/ingest`), which every spec either
# ABORTS via `blockThirdParty` or intercepts deliberately (`captureAnalytics`), so nothing
# leaves the machine either way.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_e2e_fake_token_000000000000
NEXT_PUBLIC_ADMIN_EMAILS=

# Sentry: no auth token ⇒ the build skips source-map upload. Nothing else is needed.
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
