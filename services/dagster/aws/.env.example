# =============================================================================
# INC-16-P1 — env template for the AWS Dagster + dbt-runner + flaresolverr box.
#
#   cp services/dagster/aws/.env.example services/dagster/aws/.env
#   # fill in the values below, then `chmod 600 services/dagster/aws/.env`
#
# Source of truth for the canonical complete set: the current Dagster Cloud →
# Deployment → Environment variables / Secrets export. Reconcile against it.
# .env is gitignored (see services/dagster/aws/.gitignore) — NEVER commit secrets.
#
# A missing var only bites the specific op that reads it; all FanGraphs / weather /
# alert ops are WARN/ALERT-tier, so the morning serving path runs without them —
# but fill them before enabling those sensors in Phase 4.
# =============================================================================

# --- Metadata Postgres (compose-internal; pick any strong password) ----------
DAGSTER_PG_PASSWORD=change-me-strong-random

# --- Snowflake (OLAP / dbt-runner / op queries) ------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# PEM contents (multi-line). entrypoint.sh (dbt-runner) + the Snowflake resource
# write it to /tmp/...pem on boot. In an env_file, keep it on ONE line with \n
# escapes, OR mount it as a file and set SNOWFLAKE_PRIVATE_KEY_PATH instead.
SNOWFLAKE_PRIVATE_KEY=

# --- AWS (S3 lakehouse + serving fallback + dbt state) -----------------------
# PREFERRED: attach an EC2 instance profile (IAM role) with S3 access and LEAVE
# THESE BLANK — boto3 + the S3 VPC endpoint then need no static keys. Set them
# only if you are not using an instance profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Sub-model signal scripts (generate_*_signals.py) load their .pkl artifacts from
# S3 only when a cloud-creds signal is present. With an INSTANCE PROFILE there's no
# static AWS_ACCESS_KEY_ID, so set this flag =1 to force S3 loads (the .pkl files are
# gitignored / not in the image). Without it the scripts fall back to a local path
# that doesn't exist → FileNotFoundError. (INC-16-P4 fix.)
ARTIFACTS_FROM_S3=1

# --- dbt-runner ---------------------------------------------------------------
# DBT_RUNNER_URL is set in docker-compose.yml (http://dbt-runner:8080) — do NOT
# set it here. The shared auth token must match on both codeloc and dbt-runner.
DBT_RUNNER_AUTH_TOKEN=
DBT_STATE_BUCKET=baseball-betting-ml-artifacts
DBT_STATE_PREFIX=dbt_state
TARGET_ENV=prod

# --- Serving cache (DynamoDB) — INC-16-P2 ------------------------------------
# The serving cache is DynamoDB now (Railway serving PG decommissioned). DO NOT set
# DATABASE_URL — no serving/capture path references PG anymore. write_serving_store
# reads/writes SERVING_CACHE_TABLE; S3 (CACHE_BUCKET) remains the fallback layer.
SERVING_CACHE_TABLE=credence-prod-serving-cache
# CACHE_BUCKET = the SERVING API cache bucket (picks/perf JSON under api-cache/…),
# the backend's S3 FALLBACK layer. NOT the ML artifacts bucket. write_serving_store
# SILENTLY SKIPS all S3 writes if this is unset (DynamoDB still serves, but the
# fallback goes empty) — so it must be set on the box.
CACHE_BUCKET=credence-prod-s3-api-cache

# --- Odds feeds ---------------------------------------------------------------
ODDS_API_KEY=
ODDS_API_STARTER_KEY=
PARLAY_API_KEY=

# --- Weather (OPTIONAL — not in env.required) ---------------------------------
# Only enables the OpenWeatherMap fallback in ingest_weather.py (WARN-tier; weather
# is closed as noise for totals). Leave blank — the box runs fine without it.
OPENWEATHERMAP_API_KEY=

# --- DynamoDB tables (settle_user_bets_op) -----------------------------------
# ⚠️ Set these to real values — an EMPTY value SHADOWS the script's built-in default
# (os.environ.get(k, default) returns "" when the key is present-but-empty) → boto3
# fails with "Invalid length for parameter TableName". Leave them OUT entirely if you
# want the code default; do NOT ship them blank.
USER_BETS_TABLE=credence-prod-dynamo-user-bets
USERS_TABLE=credence-prod-dynamo-users

# --- Observability alert channel (INC-16-P6) ---------------------------------
# The shared SNS topic every alert pages to (run_failure sensor, freshness sensors,
# host healthcheck, deploy.sh rollback). Set from provision-observability.sh's
# printed ARN. The notifier soft-fails if unset → alerting goes DARK, so don't ship blank.
ALERT_SNS_TOPIC_ARN=

# --- Permanently-on lakehouse-cutover flags (E11.23) — MUST be "1" -----------
# Required (deploy-time gate via env.required + runtime gate via check_monitors_healthy_op).
# An unset/"0" flag = a silently-gated-off intraday refresh (the odds-froze-3-days class).
# SCHEDULE_LAKEHOUSE_INTRADAY : keeps served game-state/lineups fresh (INC-22). Also START the
#   intraday_schedule_capture_* schedules AND disable the lean host-cron schedule-capture (no double-ingest).
# LINEUP_INTRADAY_S3_REBUILD  : the intraday lineup-confirm re-score reaches the S3 W8b feature parquet.
# W8A_LAKEHOUSE_S3 / W8B_LAKEHOUSE_S3 : feature layer + serving aggregator served from S3 (cut over 6/30).
# W7A_LAKEHOUSE_S3 / W7B_LAKEHOUSE_S3 : consumer reads (matchup/posterior/profile; predict/serving) from S3.
#   Enforced 2026-07-16 (E11.20-COST) after W7B was found never set on the box — unenforced flags drift.
# LINEUP_MONITOR_S3 : lineup-monitor detection tick reads S3+DynamoDB, not Snowflake (E11.20 phase-2a).
#   Flipped + converged 2026-07-20. Off → detection wakes COMPUTE_WH every ~10-min tick.
# W6_LAKEHOUSE_INTRADAY / W7B_INTRADAY_S3 / TICK_SF_FREE : E11.20 phase-2a steps 2+4 (2026-07-26).
#   Intraday serving/predict → S3 (W7B_INTRADAY_S3, needs W6_LAKEHOUSE_INTRADAY) + the 30-min tick skips
#   its SF ext-refresh + dbt-rebuild legs (TICK_SF_FREE, needs SCHEDULE_LAKEHOUSE_INTRADAY) = the last
#   high-frequency COMPUTE_WH wakers. ⚠️ TICK_SF_FREE in first soak — a rollback must set it 0 AND remove
#   it from env.required + monitor_health.REQUIRED_INTRADAY_FLAGS (else the heartbeat false-pages).
# See BOX_OPERATIONS.md §10 for the full intended-state table.
SCHEDULE_LAKEHOUSE_INTRADAY=1
LINEUP_INTRADAY_S3_REBUILD=1
W8A_LAKEHOUSE_S3=1
W8B_LAKEHOUSE_S3=1
W7A_LAKEHOUSE_S3=1
W7B_LAKEHOUSE_S3=1
LINEUP_MONITOR_S3=1
W6_LAKEHOUSE_INTRADAY=1
W7B_INTRADAY_S3=1
TICK_SF_FREE=1
# W6_ODDS_SF_FREE : E11.20 phase-2b — retires the intraday odds tick's two SF legs (the
#   `dbt run stg_oddsapi_odds mart_odds_outcomes` view rebuild + `refresh_w1_external_tables
#   --w6-odds`). Requires W6_LAKEHOUSE_INTRADAY=1 (the --w6-odds-current S3 parquet is what
#   makes the SF legs safe to drop); set alone it is inert + logs a loud warning.
#   ⚠️ LISTED EXPLICITLY AS 0, NOT OMITTED: on 2026-07-27 the flip silently did nothing because
#   the key was ABSENT from the box .env, so a `sed 's/^# *W6_ODDS_SF_FREE=.*/...=1/'` matched
#   nothing and the deploy succeeded with the legs still firing. A rollout flag that is absent
#   rather than present-and-0 makes "flip it" a no-op — keep every lever declared.
W6_ODDS_SF_FREE=0
# W8B_FRESHNESS_S3 : E11.20 phase-2b — routes predict_today's 30.13 serving-freshness gate
#   (`_serving_freshness_stale`) onto the Snowflake-free `_FRESHNESS_QUERY_S3` twin. Requires
#   BOTH this =1 AND the run to be in `--s3` read mode; set alone it is inert (the SF probe
#   keeps running), which is deliberate — predict_today ALREADY runs `--s3` in prod whenever
#   W7B_LAKEHOUSE_S3=1, so keying the branch off `--s3` alone would have been an immediate
#   cutover on merge rather than a gated head-start.
#   ⚠️ MATCHED PAIR with the pregame-W8b SF-leg gate-off — this must be =1 BEFORE that leg is
#   retired: the SF probe's two anchors are `information_schema.tables.last_altered`, which
#   FREEZE the moment the SF leg stops rebuilding → lag grows without bound → the gate reports
#   STALE on a perfectly fresh S3 feature store → slate-wide abstain. (SF leg ON + probe on S3
#   is the safe intermediate: the S3 parquet is already the served source.)
#   ⚠️ DECLARED AS 0, NOT OMITTED — the W6_ODDS_SF_FREE lesson directly above. Flip by APPEND
#   (or edit the real `KEY=0` line); an in-place `sed` against a commented/absent key silently
#   matches nothing and the deploy still succeeds.
W8B_FRESHNESS_S3=0
# W1_SF_COMPAT_MIRROR : E11.20 phase 1.5 — LEAVE UNSET (default 0). The SF-compat
#   season mirror + its ext tables/views are retired/dropped; =1 is the ROLLBACK path
#   only (after re-running scripts/ddl/w1_external_tables.sql).

# --- E11.24 LITERAL-ZERO SNOWFLAKE levers (August bill) ----------------------
# All three are DECLARED AS 0, NOT OMITTED (the W6_ODDS_SF_FREE lesson above): flip by editing
# the real `KEY=0` line or by APPEND — an in-place `sed` against an absent key silently matches
# nothing and the deploy still succeeds. Each needs ONE real box run before it is trusted
# (CI mocks all Snowflake/S3 IO and is blind to this whole class).
#
# E11_24_ELO_SF_FREE : betting_ml/scripts/compute_elo.py reads mart_game_results from S3 and
#   writes team_elo_history straight to the lakehouse parquet — no Snowflake session at all.
#   Kills the census's hourly `CREATE TABLE IF NOT EXISTS … team_elo_history` no-op wake (14%).
#   ⚠️ SAME-FLIP CONSEQUENCE (INC-31 writer-uniqueness): both `export_w8a_precursors_to_s3.py`
#   and `export_features_to_s3.py` then SKIP team_elo_history — they mirror the (now frozen)
#   Snowflake table over the same S3 key and would publish stale Elo over fresh. That skip is
#   automatic and guard-tested; do not "fix" it by re-adding the table.
#   Parity verified 2026-07-29: 53,592/53,592 rows identical to 5e-5 (the SF MERGE's %.4f
#   rounding), 0 date mismatches; the overwrite additionally DROPS 135 stale 2018 `OAK` rows
#   the MERGE could never delete after the OAK→ATH rebrand (duplicate rows on 135 game_pks).
E11_24_ELO_SF_FREE=0
#
# E11_24_WEATHER_SF_FREE : scripts/ingest_weather.py resolves the slate/venue + dedup reads from
#   the S3 lakehouse. Kills the census's 24/7 hourly weather/venue SELECT (14%).
#   ⚠️ HALF A FLIP SAVES NOTHING: the hourly capture still opens a Snowflake session for its
#   INSERT until the WRITE leg is also S3-only. Set both, or the read repoint is invisible in
#   `warehouse_events_history`. Needs the weather-capture image REBUILT (duckdb + ref_venues seed).
#   🚨 THE WRITE-LEG VAR FOR THIS SCRIPT IS `W11_RAW_WRITE_MODE`, **NOT** `LAKEHOUSE_RAW_WRITE_MODE`.
#   ingest_weather.py calls `w11_write_mode()` → `W11_WRITE_MODE_ENV = "W11_RAW_WRITE_MODE"` (the W11
#   Tier-A wave has its OWN switch, deliberately independent of the odds one). Setting
#   LAKEHOUSE_RAW_WRITE_MODE on weather-capture is a SILENT NO-OP — the W6_ODDS_SF_FREE class of bite.
E11_24_WEATHER_SF_FREE=0
#
# W11_RAW_WRITE_MODE : snowflake | both | s3 — the W11 Tier-A raw-write legs (weather + the typed
#   sprint_speed/oaa/catcher/park_factors/transactions writers). Default 'snowflake'. Declared here
#   because it was previously UNDECLARED while being load-bearing on the box — the exact
#   "documented-but-never-set" class.
#   ✅ VERIFIED ON THE LIVE BOX 2026-07-29: already `s3`. So the weather WRITE leg was ALREADY
#   Snowflake-free, and every one of the 73 measured weather wakes came from the slate/venue READ
#   alone — `ingest_weather.py` called get_snowflake_conn() UNCONDITIONALLY, regardless of write
#   mode. E11_24_WEATHER_SF_FREE=1 is therefore the whole fix; no write-leg change is needed.
W11_RAW_WRITE_MODE=s3
#
# E11_24_STATCAST_CATCHUP_GATE : statcast_catchup_job skips its downstream chain on a fire that
#   landed no pitches. This is the ROOT of the elo wake — the sensor re-fires hourly 04:00 ET →
#   Savant publish, so ~5 of ~6 fires do the whole chain (2 ext-table REFRESH storms, bullpen
#   dbt, 3 posterior writers, compute_elo, umpire rebuild, predict, serve) for nothing.
#   ⚠️ The chain contains `predict_today_morning` ⇒ flip only AFTER the E11.20 W8b soak closes
#   (2026-07-31) and watch one morning on the box. Fail-OPEN by construction: any lakehouse read
#   problem runs the chain, so the failure mode is "same as today", never a suppressed self-heal.
E11_24_STATCAST_CATCHUP_GATE=0
#
# ── E11.24 TARGET 6 — the intraday EB/lineup chain (2026-07-31) ────────────────────────────
# ⛔ BOTH FLIP OUTSIDE A LIVE SLATE (before ~06:00 or after ~23:30 CST). INC-36 made mid-slate
# deploys the risk window, and this is the serving/predict path — where the E11.20 false-abstain
# class recurs. Flip ONE at a time, each with its own live-slate verification.
#
# E11_24_UMPIRE_REBUILD_GATE : lineup_dbt_feature_rebuild drops the two umpire models from its
#   dbt selector when the HP-umpire assignment has not changed since the last rebuild. Measured
#   111 of 662 provisioning waits over 8 days (16.8%) — the single largest remaining COMPUTE_WH
#   waker, UTC hours 13-23. On the Snowflake target both models are literally
#   `select * from lakehouse_ext.<model>`, so every ~10-min tick re-copied an unchanged external
#   table while the assignment is written exactly ONCE per slate.
#   ⭐ The key is "an assignment NEWER than the last rebuild", never "already rebuilt today" — a
#   date key would latch in the afternoon and then SUPPRESS the rebuild that folds in the
#   ~23:10 UTC assignment, entrenching the separate late-assignment defect instead of leaving it
#   independently fixable. Fail-OPEN on every path (connect/read error, missing marker, no row
#   yet); the once-daily dbt_umpire_feature_rebuild stays UNGATED as a floor, so a wedged marker
#   costs at most one slate's intraday freshness.
E11_24_UMPIRE_REBUILD_GATE=0
#
# E11_24_BULLPEN_S3_READ : update_team_posteriors reads its bullpen observations from the S3
#   lakehouse via DuckDB instead of Snowflake (INC-25 durable fix). ⚠️ Repointing to
#   `lakehouse_ext.eb_bullpen_posteriors` would NOT have worked — that external table is only
#   refreshed at s5d, which is ALSO after lk10; the only artifact fresh at lk9 is the S3 parquet.
#   Bonus: deletes a Snowflake read that dragged a full stg_batter_pitches scan with it.
#   ⛔ Deliberately NOT fail-open — this feeds a non-idempotent, strictly-ordered chain, so a
#   silent [] would masquerade as "source not ready" and stall the metric; it raises instead.
#   ⏭️ Once soaked, update_team_posteriors_op can move BEFORE lk10 and E9.53's intraday
#   team_sequential_posteriors re-mirror retires.
E11_24_BULLPEN_S3_READ=0
#
# SNOWFLAKE_MONITOR_WAREHOUSE : the warehouse cost/metering/audit reads run on, so a cost query
#   can never RESUME the warehouse it is measuring (a measured top-3 waker, and the reason the
#   7/29 wake census had to discard its own UTC day). Requires the operator DDL:
#     CREATE WAREHOUSE IF NOT EXISTS MONITOR_WH WITH WAREHOUSE_SIZE='XSMALL'
#       AUTO_SUSPEND=60 AUTO_RESUME=TRUE INITIALLY_SUSPENDED=TRUE;
SNOWFLAKE_MONITOR_WAREHOUSE=MONITOR_WH

# --- Cognito / email / alerts (alert sensors, narratives) --------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
OWNER_EMAIL=
OWNER_USER_ID=
ADMIN_EMAILS=
SENTRY_DSN=

# --- Optional target db/schema overrides (only if overridden in Dagster+) ----
# ODDS_TARGET_DATABASE=
# ODDS_TARGET_SCHEMA=
# SAVANT_TARGET_DATABASE=
# SAVANT_TARGET_SCHEMA=
# PARLAY_TARGET_DATABASE=
# PARLAY_TARGET_SCHEMA=

# NOTE: FLARESOLVERR_URL is set in docker-compose.yml (http://flaresolverr:8191/v1)
# — do NOT set it here.

# --- dagit HTTPS + basic-auth (Caddy) — INC-16-P4 ----------------------------
# Caddy serves dagit at https://${DAGIT_HOSTNAME} behind basic-auth. The hash goes
# here AS-IS (Caddy reads it from the container env via {$VAR}; compose does not
# interpolate env_file values, so the `$` in the bcrypt hash is safe — no escaping).
#   generate the hash:  docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'
DAGIT_HOSTNAME=dagster.credencesports.com
DAGIT_BASIC_AUTH_USER=
DAGIT_BASIC_AUTH_HASH=
