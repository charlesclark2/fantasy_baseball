# Regenerable NF-FASTPATH outputs — the projection lives in the S3 lake
# (nfl/fantasy/derived/season_projections); the human-readable deliverable is the
# ablation_results report. These are rebuilt by run_season_projection.py.
*.parquet
*.csv
*_summary.json

# Per-season backfill summaries. The *_summary.json rule above does not match the backfill
# naming (..._summary_<year>.json), which is how these escaped it.
*_summary_*.json

# NF-W7e per-fold marginal-bank cache (regenerable; ~70 MB/fold)
nf_w7e_bank_cache/
