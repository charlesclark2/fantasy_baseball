{
  "manifest_version": 3,
  "name": "Credence Draft Assistant",
  "version": "0.1.0",
  "description": "Shows Credence's pick recommendation on your live ESPN draft board. Reads the draft you are already in; never signs in as you, and never sends ESPN anything.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://fantasy.espn.com/football/draft*",
    "https://api.credencesports.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["src/main-world-probe.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["src/draft-state.js", "src/overlay.js", "src/content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://credencesports.com/*",
        "https://www.credencesports.com/*"
      ],
      "js": ["src/credence-auth.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
