{
  "manifest_version": 3,
  "name": "Credence Draft Read Probe (NF-C-LDA-0 spike)",
  "version": "0.0.1",
  "description": "FEASIBILITY SPIKE. Read-only probe that reports whether the live ESPN draft state is machine-readable. Ships no recommendations and sends nothing anywhere.",
  "permissions": [],
  "host_permissions": [
    "https://fantasy.espn.com/football/draft*"
  ],
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["src/main-world-probe.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["src/content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
